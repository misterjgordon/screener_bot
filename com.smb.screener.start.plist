<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.smb.screener.start</string>
    
    <key>ProgramArguments</key>
    <array>
        <!-- Sleep to 7th second of the minute, then run (launchd has no seconds in StartCalendarInterval). -->
        <!-- Logs go to logs/screener_log/YYYY/MM/YYYY-MM-DD.log (and .error.log) -->
        <string>/bin/bash</string>
        <string>-c</string>
        <string>cd __REPO_ROOT__ &amp;&amp; LOGDIR="logs/screener_log/$(date +%Y/%m)" &amp;&amp; mkdir -p "$LOGDIR" &amp;&amp; LOGFILE="$LOGDIR/$(date +%Y-%m-%d).log" &amp;&amp; ERRFILE="$LOGDIR/$(date +%Y-%m-%d).error.log" &amp;&amp; sleep 7 &amp;&amp; exec /usr/bin/caffeinate -i -m /Users/joel/.local/bin/uv run python -m trading.smb_screener &gt;&gt; "$LOGFILE" 2&gt;&gt; "$ERRFILE"</string>
    </array>
    
    <key>WorkingDirectory</key>
    <string>__REPO_ROOT__</string>
    
    <!-- Mon–Fri; launchd Weekday: 0/7=Sun, 1=Mon, … 6=Sat (man launchd.plist) -->
    <!-- Local TZ should be PST/PDT. Wedged times: Mon–Wed 6:23, Thu–Fri 6:25 (+ sleep 7 in shell). -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key>
            <integer>1</integer>
            <key>Hour</key>
            <integer>6</integer>
            <key>Minute</key>
            <integer>23</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>2</integer>
            <key>Hour</key>
            <integer>6</integer>
            <key>Minute</key>
            <integer>23</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>3</integer>
            <key>Hour</key>
            <integer>6</integer>
            <key>Minute</key>
            <integer>23</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>4</integer>
            <key>Hour</key>
            <integer>6</integer>
            <key>Minute</key>
            <integer>25</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>5</integer>
            <key>Hour</key>
            <integer>6</integer>
            <key>Minute</key>
            <integer>25</integer>
        </dict>
    </array>
    
    <!-- Don't auto-start on login, wait for schedule -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
